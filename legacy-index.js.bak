<script>

let state = {
    settings: {},

    products: [],

    cats: []
};

let selectedCatId = null;

let editingCatId = null;

const $ =
    id =>
        document.getElementById(id);


/*
|--------------------------------------------------------------------------
| API
|--------------------------------------------------------------------------
*/

async function api(
    url,
    options = {}
) {
    const response =
        await fetch(
            url,
            {
                headers: {
                    'Content-Type':
                        'application/json',

                    ...(options.headers || {})
                },

                ...options
            }
        );

    const text =
        await response.text();

    let data;

    try {
        data =
            JSON.parse(text);
    } catch {
        data = {
            error: text
        };
    }

    if (!response.ok) {
        throw new Error(
            data.error ||
            (
                'HTTP ' +
                response.status
            )
        );
    }

    return data;
}


/*
|--------------------------------------------------------------------------
| LOAD
|--------------------------------------------------------------------------
*/

async function loadState() {

    state =
        await api(
            '/api/state'
        );

    render();

}


/*
|--------------------------------------------------------------------------
| FORMAT
|--------------------------------------------------------------------------
*/

function escapeHtml(value) {

    return String(
        value ?? ''
    ).replace(
        /[&<>"']/g,
        character => ({
            '&':
                '&amp;',

            '<':
                '&lt;',

            '>':
                '&gt;',

            '"':
                '&quot;',

            "'":
                '&#39;'
        })[
            character
        ]
    );

}

function money(value) {

    return Number(
        value || 0
    ).toLocaleString(
        'ru-RU',
        {
            maximumFractionDigits: 2
        }
    );

}

function quantity(value) {

    return Number(
        value || 0
    ).toLocaleString(
        'ru-RU',
        {
            maximumFractionDigits: 0
        }
    );

}

function formatDate(value) {

    if (!value) {
        return '—';
    }

    return new Date(
        value
    ).toLocaleString(
        'ru-RU'
    );

}


/*
|--------------------------------------------------------------------------
| CURRENT CAT
|--------------------------------------------------------------------------
*/

function currentCat() {

    return state.cats.find(
        cat =>
            cat.id ===
            selectedCatId
    );

}


/*
|--------------------------------------------------------------------------
| RENDER
|--------------------------------------------------------------------------
*/

function render() {

    renderCatList();

    const cat =
        currentCat();

    if (cat) {
        renderCat(
            cat
        );
    } else {
        renderEmpty();
    }

}

function renderCatList() {

    if (
        state.cats.length ===
        0
    ) {
        $('catList').innerHTML =
            '<div class="empty" style="padding:30px 5px">Нет котов</div>';

        return;
    }

    $('catList').innerHTML =
        state.cats
            .map(
                cat => `
                    <button
                        class="cat-button ${
                            cat.id ===
                            selectedCatId
                                ? 'active'
                                : ''
                        }"
                        onclick="selectCat('${cat.id}')"
                    >

                        <b>
                            ${escapeHtml(
                                cat.name
                            )}
                        </b>

                        <div class="cat-meta">

                            ${
                                cat.updating
                                    ? 'Обновляется...'
                                    : (
                                        cat.lastUpdatedAt
                                            ? formatDate(
                                                cat.lastUpdatedAt
                                            )
                                            : 'Ещё не обновлялся'
                                    )
                            }

                        </div>

                    </button>
                `
            )
            .join('');

}

function selectCat(id) {

    selectedCatId =
        id;

    render();

}

function renderEmpty() {

    $('pageTitle').textContent =
        'Коты';

    $('pageSubtitle').textContent =
        'Выберите кота или создайте нового';

    $('content').innerHTML = `
        <div class="panel">

            <div class="empty">

                🐱

                <br><br>

                Добавьте первого кота.

            </div>

        </div>
    `;

}


/*
|--------------------------------------------------------------------------
| CAT
|--------------------------------------------------------------------------
*/

function renderCat(cat) {

    $('pageTitle').textContent =
        cat.name;

    $('pageSubtitle').textContent =
        cat.parsedName ||
        cat.url;

    let sold = 0;
    let bought = 0;
    let revenue = 0;
    let restock = 0;
    let profit = 0;

    for (
        const item
        of cat.items
    ) {
        sold +=
            Number(
                item.sold || 0
            );

        bought +=
            Number(
                item.bought || 0
            );

        revenue +=
            Number(
                item.revenue || 0
            );

        restock +=
            Number(
                item.restockCost || 0
            );

        profit +=
            Number(
                item.profit || 0
            );
    }

    $('content').innerHTML = `

        <div class="stats">

            ${statCard(
                'Продано',
                quantity(sold)
            )}

            ${statCard(
                'Куплено',
                quantity(bought)
            )}

            ${statCard(
                'Выручка',
                money(revenue)
            )}

            ${statCard(
                'Докупка',
                money(restock)
            )}

            ${statCard(
                'Прибыль',
                money(profit),
                profit >= 0
                    ? 'good'
                    : 'bad'
            )}

        </div>

        <div class="panel">

            <div class="panel-header">

                <b>
                    Информация о коте
                </b>

                <div class="actions">

                    <button
                        class="button"
                        onclick="editCurrentCat()"
                    >
                        Изменить
                    </button>

                    <button
                        class="button primary"
                        onclick="updateCurrentCat()"
                    >
                        Обновить
                    </button>

                    <button
                        class="button"
                        onclick="openCatStats()"
                    >
                        Статистика
                    </button>

                    <button
                        class="button danger"
                        onclick="resetCurrentCat()"
                    >
                        Сброс
                    </button>

                    <button
                        class="button danger"
                        onclick="deleteCurrentCat()"
                    >
                        Удалить
                    </button>

                </div>

            </div>

            <div class="info">

                ${infoCard(
                    'Имя',
                    cat.parsedName ||
                    cat.name
                )}

                ${infoCard(
                    'Магазин',
                    cat.shopName ||
                    '—'
                )}

                ${infoCard(
                    'Локация',
                    cat.location ||
                    '—'
                )}

                ${infoCard(
                    'Координаты',
                    cat.x !== null
                        ? `${cat.x} : ${cat.y}`
                        : '—'
                )}

                <div
                    class="info-card"
                    style="grid-column:1/-1"
                >

                    <div class="info-label">
                        Ссылка comeback.pw
                    </div>

                    <a
                        href="${escapeHtml(cat.url)}"
                        target="_blank"
                        style="color:#6ea8fe"
                    >
                        ${escapeHtml(cat.url)}
                    </a>

                </div>

            </div>

        </div>

        <div class="panel">

            <div class="panel-header">

                <b>
                    Товары
                    (${cat.items.length})
                </b>

            </div>

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Товар
                            </th>

                            <th>
                                Должно быть
                                <br>
                                продажа
                            </th>

                            <th>
                                Текущее
                                <br>
                                продажа
                            </th>

                            <th>
                                Продано
                            </th>

                            <th>
                                Цена
                                <br>
                                продажа
                            </th>

                            <th>
                                Рекоменд.
                                <br>
                                продажа
                            </th>

                            <th>
                                Должно быть
                                <br>
                                покупка
                            </th>

                            <th>
                                Текущее
                                <br>
                                покупка
                            </th>

                            <th>
                                Куплено
                            </th>

                            <th>
                                Цена
                                <br>
                                покупка
                            </th>

                            <th>
                                Рекоменд.
                                <br>
                                покупка
                            </th>

                            <th>
                                Нужно
                                <br>
                                докупить
                            </th>

                            <th>
                                Где лучше
                                <br>
                                докупить
                            </th>

                            <th>
                                Прибыль
                            </th>

                            <th>
                                Прибыль
                                <br>
                                / продажа
                            </th>

                            <th></th>

                        </tr>

                    </thead>

                    <tbody>

                        ${
                            cat.items
                                .map(
                                    item =>
                                        renderItemRow(
                                            cat,
                                            item
                                        )
                                )
                                .join('')
                        }

                    </tbody>

                </table>

            </div>

        </div>
    `;

}

function statCard(
    label,
    value,
    className = ''
) {
    return `
        <div class="stat">

            <div class="stat-label">
                ${label}
            </div>

            <div class="stat-value ${className}">
                ${value}
            </div>

        </div>
    `;
}

function infoCard(
    label,
    value
) {
    return `
        <div class="info-card">

            <div class="info-label">
                ${label}
            </div>

            <div>
                ${escapeHtml(
                    value
                )}
            </div>

        </div>
    `;
}

function renderItemRow(
    cat,
    item
) {

    return `
        <tr>

            <td>

                <div class="product">

                    ${
                        item.image
                            ? `
                                <img
                                    class="product-image"
                                    src="${escapeHtml(
                                        item.image
                                    )}"
                                >
                            `
                            : ''
                    }

                    <div>

                        <div
                            class="${
                                item.configured
                                    ? ''
                                    : 'warning'
                            }"
                        >
                            ${escapeHtml(
                                item.name
                            )}
                        </div>

                        <div class="muted">
                            ID:
                            ${escapeHtml(
                                item.externalId
                            )}
                        </div>

                    </div>

                </div>

            </td>

            <td>

                <input
                    class="input"
                    type="number"
                    min="0"
                    value="${item.sellTarget}"
                    onchange="
                        updateCatItem(
                            '${cat.id}',
                            '${item.productId}',
                            'sellTarget',
                            this.value
                        )
                    "
                >

            </td>

            <td>
                ${quantity(
                    item.sellCurrent
                )}
            </td>

            <td class="${
                item.sold > 0
                    ? 'good'
                    : ''
            }">

                ${quantity(
                    item.sold
                )}

            </td>

            <td>
                ${money(
                    item.sellPrice
                )}
            </td>

            <td>
                ${money(
                    item.recommendedSell
                )}
            </td>

            <td>

                <input
                    class="input"
                    type="number"
                    min="0"
                    value="${item.buyTarget}"
                    onchange="
                        updateCatItem(
                            '${cat.id}',
                            '${item.productId}',
                            'buyTarget',
                            this.value
                        )
                    "
                >

            </td>

            <td>
                ${quantity(
                    item.buyCurrent
                )}
            </td>

            <td class="${
                item.bought > 0
                    ? 'good'
                    : ''
            }">

                ${quantity(
                    item.bought
                )}

            </td>

            <td>
                ${money(
                    item.buyPrice
                )}
            </td>

            <td>
                ${money(
                    item.recommendedBuy
                )}
            </td>

            <td class="${
                item.needToBuy > 0
                    ? 'bad'
                    : 'good'
            }">

                ${quantity(
                    item.needToBuy
                )}

            </td>

            <td>

                ${
                    item.needToBuy > 0
                        ? money(
                            item.recommendedBuy
                        )
                        : '—'
                }

            </td>

            <td class="${
                item.profit >= 0
                    ? 'good'
                    : 'bad'
            }">

                ${money(
                    item.profit
                )}

            </td>

            <td class="${
                item.profitPerSale >= 0
                    ? 'good'
                    : 'bad'
            }">

                ${money(
                    item.profitPerSale
                )}

            </td>

            <td>

                <button
                    class="button"
                    onclick="
                        editProduct(
                            '${item.productId}'
                        )
                    "
                >
                    Настроить
                </button>

            </td>

        </tr>
    `;
}


/*
|--------------------------------------------------------------------------
| CAT CREATE / EDIT
|--------------------------------------------------------------------------
*/

function createCatDialog() {

    editingCatId = null;

    openModal(
        'Новый кот',
        `
            <div class="field">

                <label>
                    Название
                </label>

                <input
                    id="catNameInput"
                    placeholder="Кот 1"
                >

            </div>

            <div class="field">

                <label>
                    Ссылка comeback.pw
                </label>

                <input
                    id="catUrlInput"
                    placeholder="https://comeback.pw/cats/146/?shop=19831968"
                >

            </div>
        `,
        `
            <button
                class="button"
                onclick="closeModal()"
            >
                Отмена
            </button>

            <button
                class="button primary"
                onclick="saveCat()"
            >
                Создать
            </button>
        `
    );
}

function editCurrentCat() {

    const cat =
        currentCat();

    if (!cat) {
        return;
    }

    editingCatId =
        cat.id;

    openModal(
        'Изменить кота',
        `
            <div class="field">

                <label>
                    Название
                </label>

                <input
                    id="catNameInput"
                    value="${escapeHtml(
                        cat.name
                    )}"
                >

            </div>

            <div class="field">

                <label>
                    Ссылка comeback.pw
                </label>

                <input
                    id="catUrlInput"
                    value="${escapeHtml(
                        cat.url
                    )}"
                >

            </div>
        `,
        `
            <button
                class="button"
                onclick="closeModal()"
            >
                Отмена
            </button>

            <button
                class="button primary"
                onclick="saveCat()"
            >
                Сохранить
            </button>
        `
    );
}

async function saveCat() {

    try {

        const body = {
            name:
                $('catNameInput')
                    .value,

            url:
                $('catUrlInput')
                    .value
        };

        if (editingCatId) {

            await api(
                '/api/cats/' +
                editingCatId,
                {
                    method: 'PUT',

                    body:
                        JSON.stringify(
                            body
                        )
                }
            );

        } else {

            const cat =
                await api(
                    '/api/cats',
                    {
                        method:
                            'POST',

                        body:
                            JSON.stringify(
                                body
                            )
                    }
                );

            selectedCatId =
                cat.id;
        }

        closeModal();

        await loadState();

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| UPDATE
|--------------------------------------------------------------------------
*/

async function updateCurrentCat() {

    if (!selectedCatId) {
        return;
    }

    try {

        await api(
            '/api/cats/' +
            selectedCatId +
            '/update',
            {
                method: 'POST'
            }
        );

        await loadState();

    } catch (error) {

        alert(
            error.message
        );

    }
}

async function updateAllCats() {

    if (
        state.cats.length ===
        0
    ) {
        alert(
            'Нет котов.'
        );

        return;
    }

    const confirmed =
        confirm(
            'Обновить всех котов последовательно?'
        );

    if (!confirmed) {
        return;
    }

    try {

        await api(
            '/api/cats/update-all',
            {
                method: 'POST'
            }
        );

        await loadState();

        alert(
            'Обновление завершено.'
        );

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| CAT ITEM
|--------------------------------------------------------------------------
*/

async function updateCatItem(
    catId,
    productId,
    field,
    value
) {

    try {

        await api(
            '/api/cats/' +
            catId +
            '/items/' +
            productId,
            {
                method: 'PUT',

                body:
                    JSON.stringify({
                        [field]:
                            Number(
                                value
                            )
                    })
            }
        );

        await loadState();

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| PRODUCTS
|--------------------------------------------------------------------------
*/

function openProducts() {

    const body =
        state.products
            .map(
                product => `
                    <div class="product-editor">

                        <div>

                            <b
                                class="${
                                    product.configured
                                        ? ''
                                        : 'warning'
                                }"
                            >
                                ${escapeHtml(
                                    product.name
                                )}
                            </b>

                            <span class="muted">

                                ID:
                                ${escapeHtml(
                                    product.externalId
                                )}

                                ${
                                    product.configured
                                        ? ''
                                        : ' — не настроен'
                                }

                            </span>

                        </div>

                        <div
                            class="product-editor-grid"
                        >

                            ${productField(
                                product,
                                'buyPrice',
                                'Скупка'
                            )}

                            ${productField(
                                product,
                                'sellPrice',
                                'Продажа'
                            )}

                            ${productField(
                                product,
                                'goldShopPrice',
                                'Цена в gold shop'
                            )}

                            ${productField(
                                product,
                                'goldPrice',
                                'Цена gold'
                            )}

                        </div>

                        <button
                            class="button primary"
                            onclick="
                                saveProduct(
                                    '${product.id}'
                                )
                            "
                        >
                            Сохранить
                        </button>

                    </div>
                `
            )
            .join('');

    openModal(
        'База товаров',
        body ||
            '<div class="empty">Товаров пока нет.</div>',
        `
            <button
                class="button"
                onclick="closeModal()"
            >
                Закрыть
            </button>
        `
    );
}

function productField(
    product,
    field,
    label
) {
    return `
        <div class="field">

            <label>
                ${label}
            </label>

            <input
                id="product-${field}-${product.id}"
                type="number"
                min="0"
                value="${product[field] || 0}"
            >

        </div>
    `;
}

async function saveProduct(
    productId
) {

    try {

        await api(
            '/api/products/' +
            productId,
            {
                method: 'PUT',

                body:
                    JSON.stringify({
                        buyPrice:
                            Number(
                                $(
                                    'product-buyPrice-' +
                                    productId
                                ).value
                            ),

                        sellPrice:
                            Number(
                                $(
                                    'product-sellPrice-' +
                                    productId
                                ).value
                            ),

                        goldShopPrice:
                            Number(
                                $(
                                    'product-goldShopPrice-' +
                                    productId
                                ).value
                            ),

                        goldPrice:
                            Number(
                                $(
                                    'product-goldPrice-' +
                                    productId
                                ).value
                            )
                    })
            }
        );

        await loadState();

        openProducts();

    } catch (error) {

        alert(
            error.message
        );

    }
}

function editProduct(
    productId
) {

    openProducts();

    setTimeout(
        () => {

            const element =
                document.getElementById(
                    'product-buyPrice-' +
                    productId
                );

            if (element) {
                element.scrollIntoView({
                    behavior:
                        'smooth',

                    block:
                        'center'
                });
            }

        },
        50
    );
}


/*
|--------------------------------------------------------------------------
| SETTINGS
|--------------------------------------------------------------------------
*/

function openSettings() {

    openModal(
        'Настройки',
        `
            <div class="field">

                <label>
                    Интервал между котами, мс
                </label>

                <input
                    id="settingsInterval"
                    type="number"
                    min="1000"
                    value="${
                        state
                            .settings
                            .updateIntervalMs
                    }"
                >

            </div>

            <div class="field">

                <label>
                    Цена gold
                </label>

                <input
                    id="settingsGoldPrice"
                    type="number"
                    min="0"
                    value="${
                        state
                            .settings
                            .goldPrice
                    }"
                >

            </div>
        `,
        `
            <button
                class="button"
                onclick="closeModal()"
            >
                Отмена
            </button>

            <button
                class="button primary"
                onclick="saveSettings()"
            >
                Сохранить
            </button>
        `
    );
}

async function saveSettings() {

    try {

        await api(
            '/api/settings',
            {
                method: 'PUT',

                body:
                    JSON.stringify({
                        updateIntervalMs:
                            Number(
                                $(
                                    'settingsInterval'
                                ).value
                            ),

                        goldPrice:
                            Number(
                                $(
                                    'settingsGoldPrice'
                                ).value
                            )
                    })
            }
        );

        closeModal();

        await loadState();

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| STATISTICS
|--------------------------------------------------------------------------
*/

async function openCatStats() {

    if (!selectedCatId) {
        return;
    }

    try {

        const stats =
            await api(
                '/api/stats/cat/' +
                selectedCatId
            );

        openModal(
            'Статистика кота',
            `
                <div class="stats">

                    ${statCard(
                        'Продано',
                        quantity(
                            stats.sold
                        )
                    )}

                    ${statCard(
                        'Куплено',
                        quantity(
                            stats.bought
                        )
                    )}

                    ${statCard(
                        'Выручка',
                        money(
                            stats.revenue
                        )
                    )}

                    ${statCard(
                        'Докупка',
                        money(
                            stats.restockCost
                        )
                    )}

                    ${statCard(
                        'Прибыль',
                        money(
                            stats.profit
                        ),
                        stats.profit >= 0
                            ? 'good'
                            : 'bad'
                    )}

                </div>
            `,
            `
                <button
                    class="button"
                    onclick="closeModal()"
                >
                    Закрыть
                </button>
            `
        );

    } catch (error) {

        alert(
            error.message
        );

    }
}

async function openAllStats() {

    try {

        const data =
            await api(
                '/api/stats/all'
            );

        const catRows =
            data.cats
                .map(
                    cat => `
                        <div class="panel">

                            <div
                                class="panel-header"
                            >

                                <b>
                                    ${escapeHtml(
                                        cat.name
                                    )}
                                </b>

                                <span>

                                    Продано:
                                    ${quantity(
                                        cat.sold
                                    )}

                                    &nbsp; |

                                    Куплено:
                                    ${quantity(
                                        cat.bought
                                    )}

                                    &nbsp; |

                                    Прибыль:
                                    ${money(
                                        cat.profit
                                    )}

                                </span>

                            </div>

                        </div>
                    `
                )
                .join('');

        openModal(
            'Статистика всех котов',
            `
                <div class="stats">

                    ${statCard(
                        'Продано',
                        quantity(
                            data.total.sold
                        )
                    )}

                    ${statCard(
                        'Куплено',
                        quantity(
                            data.total.bought
                        )
                    )}

                    ${statCard(
                        'Выручка',
                        money(
                            data.total.revenue
                        )
                    )}

                    ${statCard(
                        'Докупка',
                        money(
                            data.total.restockCost
                        )
                    )}

                    ${statCard(
                        'Прибыль',
                        money(
                            data.total.profit
                        ),
                        data.total.profit >= 0
                            ? 'good'
                            : 'bad'
                    )}

                </div>

                ${catRows}
            `,
            `
                <button
                    class="button"
                    onclick="closeModal()"
                >
                    Закрыть
                </button>
            `
        );

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| RESET / DELETE
|--------------------------------------------------------------------------
*/

async function resetCurrentCat() {

    if (!selectedCatId) {
        return;
    }

    if (
        !confirm(
            'Создать новую точку отсчёта статистики?'
        )
    ) {
        return;
    }

    try {

        await api(
            '/api/cats/' +
            selectedCatId +
            '/reset',
            {
                method: 'POST'
            }
        );

        alert(
            'Сброс сохранён.'
        );

    } catch (error) {

        alert(
            error.message
        );

    }
}

async function deleteCurrentCat() {

    if (!selectedCatId) {
        return;
    }

    if (
        !confirm(
            'Удалить кота?'
        )
    ) {
        return;
    }

    try {

        await api(
            '/api/cats/' +
            selectedCatId,
            {
                method: 'DELETE'
            }
        );

        selectedCatId =
            null;

        await loadState();

    } catch (error) {

        alert(
            error.message
        );

    }
}


/*
|--------------------------------------------------------------------------
| MODAL
|--------------------------------------------------------------------------
*/

function openModal(
    title,
    body,
    footer
) {
    $('modalTitle')
        .textContent =
        title;

    $('modalBody')
        .innerHTML =
        body;

    $('modalFooter')
        .innerHTML =
        footer;

    $('modal')
        .classList
        .add('open');
}

function closeModal() {

    $('modal')
        .classList
        .remove('open');

}

$('modal')
    .addEventListener(
        'click',
        event => {

            if (
                event.target ===
                $('modal')
            ) {
                closeModal();
            }

        }
    );


/*
|--------------------------------------------------------------------------
| START
|--------------------------------------------------------------------------
*/

loadState()
    .catch(
        error => {
            alert(
                error.message
            );
        }
    );

</script>

</body>

</html>`;

