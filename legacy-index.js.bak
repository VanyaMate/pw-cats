    (req, res) => {
        res
            .type('html')
            .send(HTML);
    }
);

app.get(
    '/api/health',
    (req, res) => {
        res.json({
            ok: true,

            cats:
                database.cats.length,

            products:
                database.products.length,

            proxy:
                PROXY_URL
        });
    }
);

