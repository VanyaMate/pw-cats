'use strict';

const express = require('express');
const axios = require('axios');
const cheerio = require('cheerio');
const { HttpsProxyAgent } = require('https-proxy-agent');

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const app = express();

const PORT = 3030;
const DB_FILE = path.join(__dirname, 'pw-cats.json');

const PROXY_URL = 'socks5://127.0.0.1:3066';

const proxyAgent = new HttpsProxyAgent(PROXY_URL);

const axiosOptions = {
    httpAgent: proxyAgent,
    httpsAgent: proxyAgent,
    proxy: false,
    timeout: 30000,

    headers: {
        'User-Agent':
            'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/140 Safari/537.36',

        'Accept-Language':
            'ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7'
    }
};

/*
|--------------------------------------------------------------------------
| HELPERS
|--------------------------------------------------------------------------
*/

function createId() {
    return crypto.randomUUID();
}

function now() {
    return new Date().toISOString();
}

function toNumber(value, fallback = 0) {
    const number = Number(value);

    if (!Number.isFinite(number)) {
        return fallback;
    }

    return number;
}

function toInt(value, fallback = 0) {
    return Math.floor(
        toNumber(value, fallback)
    );
}

function sleep(ms) {
    return new Promise(resolve => {
        setTimeout(resolve, ms);
    });
}

function normalizeUrl(value) {
    let url = String(value || '').trim();

    if (!url) {
        return '';
    }

    if (!/^https?:\/\//i.test(url)) {
        url = 'https://' + url;
    }

    return url;
}

function cleanText(value) {
    return String(value || '')
        .replace(/\s+/g, ' ')
        .trim();
}

function parsePrice(value) {
    if (value === undefined || value === null) {
        return 0;
    }

    const text = String(value)
        .replace(/\s/g, '')
        .replace(',', '.')
        .replace(/[^0-9.-]/g, '');

    const result = Number(text);

    return Number.isFinite(result)
        ? result
        : 0;
}

function parseCount(value) {
    return Math.max(
        0,
        Math.floor(
            parsePrice(value)
        )
    );
}

function absoluteUrl(url, baseUrl) {
    try {
        return new URL(
            url,
            baseUrl
        ).toString();
    } catch {
        return url || '';
    }
}

/*
|--------------------------------------------------------------------------
| DATABASE
|--------------------------------------------------------------------------
*/

function createEmptyDatabase() {
    return {
        version: 1,

        settings: {
            updateIntervalMs: 7000,
            goldPrice: 0
        },

        products: [],

        cats: [],

        history: []
    };
}

function loadDatabase() {
    if (!fs.existsSync(DB_FILE)) {
        return createEmptyDatabase();
    }

    try {
        const data = JSON.parse(
            fs.readFileSync(
                DB_FILE,
                'utf8'
            )
        );

        const empty =
            createEmptyDatabase();

        return {
            ...empty,

            ...data,

            settings: {
                ...empty.settings,
                ...(data.settings || {})
            },

            products:
                Array.isArray(data.products)
                    ? data.products
                    : [],

            cats:
                Array.isArray(data.cats)
                    ? data.cats
                    : [],

            history:
                Array.isArray(data.history)
                    ? data.history
                    : []
        };
    } catch (error) {
        console.error(
            'Ошибка чтения базы:',
            error.message
        );

        return createEmptyDatabase();
    }
}

let database = loadDatabase();

function saveDatabase() {
    const temporaryFile =
        DB_FILE + '.tmp';

    fs.writeFileSync(
        temporaryFile,
        JSON.stringify(
            database,
            null,
            2
        ),
        'utf8'
    );

    fs.renameSync(
        temporaryFile,
        DB_FILE
    );
}

/*
|--------------------------------------------------------------------------
| URL HELPERS
|--------------------------------------------------------------------------
*/

function getCatIdFromUrl(url) {
    try {
        const parsed =
            new URL(
                normalizeUrl(url)
            );

        const match =
            parsed.pathname.match(
                /\/cats\/(\d+)/i
            );

        return match
            ? match[1]
            : '';
    } catch {
        return '';
    }
}

function getQueryParameter(
    url,
    parameter
) {
    try {
        const parsed =
            new URL(
                normalizeUrl(url)
            );

        return (
            parsed.searchParams.get(
                parameter
            ) || ''
        );
    } catch {
        return '';
    }
}

function buildShopUrl(
    baseUrl,
    show,
    page
) {
    const url =
        new URL(
            normalizeUrl(baseUrl)
        );

    /*
     * item_id удаляем.
     * Нам нужен весь магазин.
     */

    url.searchParams.delete(
        'item_id'
    );

    url.searchParams.set(
        'show',
        show
    );

    url.searchParams.set(
        'page',
        String(page)
    );

    return url.toString();
}

/*
|--------------------------------------------------------------------------
| PARSER
|--------------------------------------------------------------------------
*/

function parseShopPage(
    html,
    pageUrl
) {
    const $ =
        cheerio.load(html);

    const items = [];

    /*
     * Основной источник товаров:
     *
     * <img class="item_shop"
     *      data-name="..."
     *      data-price="..."
     *      data-count="..."
     *      data-id="..."
     *      src="...">
     */

    $('img.item_shop[data-id]')
        .each(
            (_, element) => {
                const node =
                    $(element);

                const externalId =
                    cleanText(
                        node.attr(
                            'data-id'
                        )
                    );

                if (!externalId) {
                    return;
                }

                items.push({
                    externalId,

                    name:
                        cleanText(
                            node.attr(
                                'data-name'
                            )
                        ) ||
                        `Товар ${externalId}`,

                    count:
                        parseCount(
                            node.attr(
                                'data-count'
                            )
                        ),

                    price:
                        parsePrice(
                            node.attr(
                                'data-price'
                            )
                        ),

                    image:
                        absoluteUrl(
                            node.attr(
                                'src'
                            ) || '',
                            pageUrl
                        ),

                    description:
                        node.attr(
                            'data-desc'
                        ) || ''
                });
            }
        );

    /*
     * Убираем дубликаты.
     */

    const unique =
        new Map();

    for (
        const item
        of items
    ) {
        unique.set(
            item.externalId,
            item
        );
    }

    /*
     * Дополнительная информация
     * о коте/магазине.
     */

    const bodyText =
        cleanText(
            $('body').text()
        );

    const title =
        cleanText(
            $('title')
                .first()
                .text()
        );

    const meta = {
        title,

        catName: '',

        shopName: '',

        location: '',

        x: null,

        y: null
    };

    /*
     * Попытки найти имя кота.
     */

    const catNameSelectors = [
        '[data-cat-name]',
        '[data-character-name]',
        '.cat_name',
        '.cat-name',
        '.character_name',
        '.character-name'
    ];

    for (
        const selector
        of catNameSelectors
    ) {
        const element =
            $(selector)
                .first();

        if (!element.length) {
            continue;
        }

        meta.catName =
            cleanText(
                element.attr(
                    'data-cat-name'
                ) ||
                element.attr(
                    'data-character-name'
                ) ||
                element.text()
            );

        if (meta.catName) {
            break;
        }
    }

    /*
     * Магазин.
     */

    const shopSelectors = [
        '[data-shop-name]',
        '.shop_name',
        '.shop-name',
        '.shop_title',
        '.shop-title',
        '.npc_name',
        '.seller_name'
    ];

    for (
        const selector
        of shopSelectors
    ) {
        const element =
            $(selector)
                .first();

        if (!element.length) {
            continue;
        }

        meta.shopName =
            cleanText(
                element.attr(
                    'data-shop-name'
                ) ||
                element.text()
            );

        if (meta.shopName) {
            break;
        }
    }

    /*
     * Локация.
     */

    const locationSelectors = [
        '[data-location]',
        '.location',
        '.shop_location',
        '.shop-location',
        '.coords',
        '.coordinates'
    ];

    for (
        const selector
        of locationSelectors
    ) {
        const element =
            $(selector)
                .first();

        if (!element.length) {
            continue;
        }

        meta.location =
            cleanText(
                element.attr(
                    'data-location'
                ) ||
                element.text()
            );

        if (meta.location) {
            break;
        }
    }

    /*
     * Координаты.
     *
     * Это намеренно несколько мягких вариантов,
     * поскольку точный HTML блока координат
     * пока неизвестен.
     */

    const coordinates =
        bodyText.match(
            /X\s*[:=]\s*(-?\d+(?:[.,]\d+)?)\D+Y\s*[:=]\s*(-?\d+(?:[.,]\d+)?)/i
        );

    if (coordinates) {
        meta.x =
            Number(
                coordinates[1]
                    .replace(',', '.')
            );

        meta.y =
            Number(
                coordinates[2]
                    .replace(',', '.')
            );
    }

    return {
        items:
            Array.from(
                unique.values()
            ),

        meta
    };
}

/*
|--------------------------------------------------------------------------
| REQUESTS
|--------------------------------------------------------------------------
*/

async function fetchHtml(url) {
    const response =
        await axios.get(
            url,
            axiosOptions
        );

    return String(
        response.data || ''
    );
}

async function fetchShop(
    baseUrl,
    show
) {
    const allItems =
        new Map();

    let meta = {};

    /*
     * Максимум 50 страниц.
     * Если страница пустая — останавливаемся.
     */

    for (
        let page = 1;
        page <= 50;
        page++
    ) {
        const url =
            buildShopUrl(
                baseUrl,
                show,
                page
            );

        const html =
            await fetchHtml(url);

        const parsed =
            parseShopPage(
                html,
                url
            );

        if (page === 1) {
            meta = parsed.meta;
        }

        if (
            parsed.items.length === 0
        ) {
            break;
        }

        let newItems = 0;

        for (
            const item
            of parsed.items
        ) {
            if (
                !allItems.has(
                    item.externalId
                )
            ) {
                newItems++;
            }

            allItems.set(
                item.externalId,
                item
            );
        }

        /*
         * Если новая страница полностью
         * состоит из уже известных товаров,
         * прекращаем обход.
         */

        if (
            page > 1 &&
            newItems === 0
        ) {
            break;
        }

        /*
         * Для обычного магазина 20 элементов
         * означает полную страницу.
         *
         * Если меньше 20 — вероятнее всего
         * это последняя страница.
         */

        if (
            parsed.items.length < 20
        ) {
            break;
        }
    }

    return {
        items:
            Array.from(
                allItems.values()
            ),

        meta
    };
}

/*
|--------------------------------------------------------------------------
| PRODUCTS
|--------------------------------------------------------------------------
*/

function findProduct(
    externalId
) {
    return database.products.find(
        product =>
            String(
                product.externalId
            ) ===
            String(externalId)
    );
}

function getOrCreateProduct(
    parsedItem
) {
    let product =
        findProduct(
            parsedItem.externalId
        );

    if (!product) {
        product = {
            id: createId(),

            externalId:
                String(
                    parsedItem.externalId
                ),

            name:
                parsedItem.name,

            image:
                parsedItem.image,

            description:
                parsedItem.description,

            /*
             * false = товар автоматически
             * добавлен, но ещё не настроен.
             */

            configured: false,

            /*
             * Ручные цены.
             */

            buyPrice: 0,

            sellPrice: 0,

            /*
             * Цена товара через gold shop.
             */

            goldShopPrice: 0,

            /*
             * Можно задать отдельно
             * для конкретного товара.
             *
             * Если 0 — используется
             * глобальная цена gold.
             */

            goldPrice: 0,

            /*
             * Последние цены из парсера.
             */

            lastSellPrice: 0,

            lastBuyPrice: 0,

            createdAt: now(),

            updatedAt: now()
        };

        database.products.push(
            product
        );
    } else {
        if (parsedItem.name) {
            product.name =
                parsedItem.name;
        }

        if (parsedItem.image) {
            product.image =
                parsedItem.image;
        }

        if (
            parsedItem.description
        ) {
            product.description =
                parsedItem.description;
        }

        product.updatedAt =
            now();
    }

    return product;
}

/*
|--------------------------------------------------------------------------
| CAT ITEMS
|--------------------------------------------------------------------------
*/

function getCatItem(
    cat,
    productId
) {
    return cat.items.find(
        item =>
            item.productId ===
            productId
    );
}

function getOrCreateCatItem(
    cat,
    product
) {
    let item =
        getCatItem(
            cat,
            product.id
        );

    if (!item) {
        item = {
            productId:
                product.id,

            /*
             * Сколько должно находиться
             * в продаже.
             */

            sellTarget: 0,

            /*
             * Сколько должно быть
             * на покупке/скупке.
             */

            buyTarget: 0,

            /*
             * Текущее количество
             * с парсера.
             */

            sellCurrent: 0,

            buyCurrent: 0,

            /*
             * Последняя цена
             * конкретного кота.
             */

            sellPrice: 0,

            buyPrice: 0,

            lastSellUpdate: null,

            lastBuyUpdate: null
        };

        cat.items.push(
            item
        );
    }

    return item;
}

/*
|--------------------------------------------------------------------------
| RECOMMENDED PRICE
|--------------------------------------------------------------------------
*/

function getRecommendedPrice(
    product,
    side
) {
    /*
     * Продажа:
     *
     * 1. вручную указанная цена продажи
     * 2. цена из gold shop * курс gold
     * 3. последняя цена из парсера
     *
     * Покупка:
     *
     * 1. вручную указанная цена скупки
     * 2. цена из gold shop * курс gold
     * 3. последняя цена из парсера
     */

    if (side === 'sell') {
        if (
            toNumber(
                product.sellPrice
            ) > 0
        ) {
            return product.sellPrice;
        }
    } else {
        if (
            toNumber(
                product.buyPrice
            ) > 0
        ) {
            return product.buyPrice;
        }
    }

    const goldPrice =
        toNumber(
            product.goldPrice
        ) ||
        toNumber(
            database.settings.goldPrice
        );

    const goldShopPrice =
        toNumber(
            product.goldShopPrice
        );

    if (
        goldShopPrice > 0 &&
        goldPrice > 0
    ) {
        return (
            goldShopPrice *
            goldPrice
        );
    }

    return side === 'sell'
        ? toNumber(
            product.lastSellPrice
        )
        : toNumber(
            product.lastBuyPrice
        );
}

/*
|--------------------------------------------------------------------------
| CALCULATIONS
|--------------------------------------------------------------------------
*/

function calculateItem(
    item,
    product
) {
    const sellTarget =
        toNumber(
            item.sellTarget
        );

    const sellCurrent =
        toNumber(
            item.sellCurrent
        );

    const buyTarget =
        toNumber(
            item.buyTarget
        );

    const buyCurrent =
        toNumber(
            item.buyCurrent
        );

    /*
     * Что реально продалось
     * относительно заданного остатка.
     */

    const sold =
        Math.max(
            0,
            sellTarget -
            sellCurrent
        );

    /*
     * Что было куплено
     * относительно заданного остатка.
     */

    const bought =
        Math.max(
            0,
            buyTarget -
            buyCurrent
        );

    /*
     * Сколько нужно докупить,
     * чтобы вернуть продажный запас
     * к sellTarget.
     */

    const needToBuy =
        Math.max(
            0,
            sellTarget -
            sellCurrent
        );

    const sellPrice =
        toNumber(
            item.sellPrice
        ) ||
        toNumber(
            product.lastSellPrice
        );

    const buyPrice =
        toNumber(
            item.buyPrice
        ) ||
        toNumber(
            product.lastBuyPrice
        );

    const recommendedSell =
        getRecommendedPrice(
            product,
            'sell'
        );

    const recommendedBuy =
        getRecommendedPrice(
            product,
            'buy'
        );

    /*
     * Финансовая модель:
     *
     * Выручка:
     * sold * фактическая цена продажи
     *
     * Покупка:
     * bought * фактическая цена покупки
     *
     * Будущая докупка:
     * needToBuy * рекомендуемая цена покупки
     *
     * Прибыль:
     * выручка - покупки - докупка
     */

    const revenue =
        sold *
        sellPrice;

    const purchaseCost =
        bought *
        buyPrice;

    const restockCost =
        needToBuy *
        recommendedBuy;

    const profit =
        revenue -
        purchaseCost -
        restockCost;

    const profitPerSale =
        sold > 0
            ? profit / sold
            : 0;

    return {
        sellTarget,
        sellCurrent,
        sold,

        sellPrice,
        recommendedSell,

        buyTarget,
        buyCurrent,
        bought,

        buyPrice,
        recommendedBuy,

        needToBuy,

        revenue,
        purchaseCost,
        restockCost,

        profit,
        profitPerSale
    };
}

/*
|--------------------------------------------------------------------------
| SNAPSHOTS / HISTORY
|--------------------------------------------------------------------------
*/

function makeSnapshot(cat) {
    return cat.items.map(
        item => ({
            productId:
                item.productId,

            sellCurrent:
                toNumber(
                    item.sellCurrent
                ),

            buyCurrent:
                toNumber(
                    item.buyCurrent
                ),

            sellPrice:
                toNumber(
                    item.sellPrice
                ),

            buyPrice:
                toNumber(
                    item.buyPrice
                )
        })
    );
}

function compareSnapshots(
    before,
    after
) {
    const beforeMap =
        new Map(
            before.map(
                item => [
                    item.productId,
                    item
                ]
            )
        );

    const changes = [];

    for (
        const current
        of after
    ) {
        const previous =
            beforeMap.get(
                current.productId
            );

        if (!previous) {
            changes.push({
                productId:
                    current.productId,

                type: 'added'
            });

            continue;
        }

        const fields = [
            'sellCurrent',
            'buyCurrent',
            'sellPrice',
            'buyPrice'
        ];

        for (
            const field
            of fields
        ) {
            if (
                previous[field] !==
                current[field]
            ) {
                changes.push({
                    productId:
                        current.productId,

                    field,

                    from:
                        previous[field],

                    to:
                        current[field]
                });
            }
        }
    }

    return changes;
}

/*
|--------------------------------------------------------------------------
| UPDATE CAT
|--------------------------------------------------------------------------
*/

async function updateCat(
    cat
) {
    const before =
        makeSnapshot(cat);

    /*
     * Сначала продажа.
     */

    const sell =
        await fetchShop(
            cat.url,
            'sell'
        );

    /*
     * Небольшая пауза между запросами.
     */

    await sleep(1000);

    /*
     * Затем покупка.
     */

    const buy =
        await fetchShop(
            cat.url,
            'buy'
        );

    const sellMap =
        new Map();

    const buyMap =
        new Map();

    for (
        const item
        of sell.items
    ) {
        sellMap.set(
            item.externalId,
            item
        );
    }

    for (
        const item
        of buy.items
    ) {
        buyMap.set(
            item.externalId,
            item
        );
    }

    /*
     * Все товары из sell + buy
     * автоматически добавляются
     * в общую БД.
     */

    const allItems = [
        ...sell.items,
        ...buy.items
    ];

    for (
        const parsedItem
        of allItems
    ) {
        const product =
            getOrCreateProduct(
                parsedItem
            );

        const catItem =
            getOrCreateCatItem(
                cat,
                product
            );

        const sellItem =
            sellMap.get(
                product.externalId
            );

        const buyItem =
            buyMap.get(
                product.externalId
            );

        if (sellItem) {
            catItem.sellCurrent =
                sellItem.count;

            catItem.sellPrice =
                sellItem.price;

            catItem.lastSellUpdate =
                now();

            product.lastSellPrice =
                sellItem.price;
        }

        if (buyItem) {
            catItem.buyCurrent =
                buyItem.count;

            catItem.buyPrice =
                buyItem.price;

            catItem.lastBuyUpdate =
                now();

            product.lastBuyPrice =
                buyItem.price;
        }
    }

    /*
     * Информация о магазине.
     */

    const meta =
        sell.meta || {};

    if (meta.catName) {
        cat.parsedName =
            meta.catName;
    }

    if (meta.shopName) {
        cat.shopName =
            meta.shopName;
    }

    if (meta.location) {
        cat.location =
            meta.location;
    }

    if (
        meta.x !== null
    ) {
        cat.x =
            meta.x;
    }

    if (
        meta.y !== null
    ) {
        cat.y =
            meta.y;
    }

    cat.lastUpdatedAt =
        now();

    /*
     * Сохраняем историю изменения.
     */

    const after =
        makeSnapshot(cat);

    const changes =
        compareSnapshots(
            before,
            after
        );

    database.history.push({
        id: createId(),

        type: 'update',

        catId:
            cat.id,

        createdAt:
            now(),

        changes,

        snapshot:
            after
    });

    /*
     * Ограничиваем размер истории.
     */

    if (
        database.history.length >
        50000
    ) {
        database.history.splice(
            0,
            database.history.length -
            50000
        );
    }

    saveDatabase();

    return {
        sellItems:
            sell.items.length,

        buyItems:
            buy.items.length,

        changes:
            changes.length
    };
}

/*
|--------------------------------------------------------------------------
| API
|--------------------------------------------------------------------------
*/

app.use(
    express.json({
        limit: '2mb'
    })
);

/*
 * Вся текущая база.
 */

app.get(
    '/api/state',
    (req, res) => {
        res.json({
            settings:
                database.settings,

            products:
                database.products,

            cats:
                database.cats.map(
                    buildCatResponse
                )
        });
    }
);

/*
|--------------------------------------------------------------------------
| SETTINGS
|--------------------------------------------------------------------------
*/

app.put(
    '/api/settings',
    (req, res) => {
        database.settings.updateIntervalMs =
            Math.max(
                1000,
                toInt(
                    req.body.updateIntervalMs,
                    7000
                )
            );

        database.settings.goldPrice =
            Math.max(
                0,
                toNumber(
                    req.body.goldPrice
                )
            );

        saveDatabase();

        res.json(
            database.settings
        );
    }
);

/*
|--------------------------------------------------------------------------
| CATS
|--------------------------------------------------------------------------
*/

app.post(
    '/api/cats',
    (req, res) => {
        const url =
            normalizeUrl(
                req.body.url
            );

        if (!url) {
            return res
                .status(400)
                .json({
                    error:
                        'Не указана ссылка comeback.pw'
                });
        }

        const cat = {
            id: createId(),

            name:
                cleanText(
                    req.body.name
                ) ||
                `Кот ${
                    database.cats.length + 1
                }`,

            url,

            comebackCatId:
                getCatIdFromUrl(
                    url
                ),

            shopId:
                getQueryParameter(
                    url,
                    'shop'
                ),

            parsedName: '',

            shopName: '',

            location: '',

            x: null,

            y: null,

            items: [],

            updating: false,

            updateError: null,

            createdAt: now(),

            lastUpdatedAt: null
        };

        database.cats.push(
            cat
        );

        saveDatabase();

        res.json(
            buildCatResponse(
                cat
            )
        );
    }
);

app.put(
    '/api/cats/:id',
    (req, res) => {
        const cat =
            database.cats.find(
                item =>
                    item.id ===
                    req.params.id
            );

        if (!cat) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        if (
            req.body.name !==
            undefined
        ) {
            cat.name =
                cleanText(
                    req.body.name
                );
        }

        if (
            req.body.url !==
            undefined
        ) {
            cat.url =
                normalizeUrl(
                    req.body.url
                );

            cat.comebackCatId =
                getCatIdFromUrl(
                    cat.url
                );

            cat.shopId =
                getQueryParameter(
                    cat.url,
                    'shop'
                );
        }

        saveDatabase();

        res.json(
            buildCatResponse(
                cat
            )
        );
    }
);

app.delete(
    '/api/cats/:id',
    (req, res) => {
        const index =
            database.cats.findIndex(
                cat =>
                    cat.id ===
                    req.params.id
            );

        if (index === -1) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        database.cats.splice(
            index,
            1
        );

        saveDatabase();

        res.json({
            ok: true
        });
    }
);

/*
|--------------------------------------------------------------------------
| CAT ITEM SETTINGS
|--------------------------------------------------------------------------
*/

app.put(
    '/api/cats/:catId/items/:productId',
    (req, res) => {
        const cat =
            database.cats.find(
                item =>
                    item.id ===
                    req.params.catId
            );

        if (!cat) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        const product =
            database.products.find(
                item =>
                    item.id ===
                    req.params.productId
            );

        if (!product) {
            return res
                .status(404)
                .json({
                    error:
                        'Товар не найден'
                });
        }

        const item =
            getOrCreateCatItem(
                cat,
                product
            );

        if (
            req.body.sellTarget !==
            undefined
        ) {
            item.sellTarget =
                Math.max(
                    0,
                    toInt(
                        req.body.sellTarget
                    )
                );
        }

        if (
            req.body.buyTarget !==
            undefined
        ) {
            item.buyTarget =
                Math.max(
                    0,
                    toInt(
                        req.body.buyTarget
                    )
                );
        }

        saveDatabase();

        res.json(
            buildCatResponse(
                cat
            )
        );
    }
);

/*
|--------------------------------------------------------------------------
| PRODUCTS
|--------------------------------------------------------------------------
*/

app.put(
    '/api/products/:id',
    (req, res) => {
        const product =
            database.products.find(
                item =>
                    item.id ===
                    req.params.id
            );

        if (!product) {
            return res
                .status(404)
                .json({
                    error:
                        'Товар не найден'
                });
        }

        const priceFields = [
            'buyPrice',
            'sellPrice',
            'goldShopPrice',
            'goldPrice'
        ];

        for (
            const field
            of priceFields
        ) {
            if (
                req.body[field] !==
                undefined
            ) {
                product[field] =
                    Math.max(
                        0,
                        toNumber(
                            req.body[field]
                        )
                    );
            }
        }

        product.configured =
            product.buyPrice > 0 ||
            product.sellPrice > 0 ||
            product.goldShopPrice > 0 ||
            product.goldPrice > 0;

        product.updatedAt =
            now();

        saveDatabase();

        res.json(product);
    }
);

/*
|--------------------------------------------------------------------------
| UPDATE ONE CAT
|--------------------------------------------------------------------------
*/

app.post(
    '/api/cats/:id/update',
    async (req, res) => {
        const cat =
            database.cats.find(
                item =>
                    item.id ===
                    req.params.id
            );

        if (!cat) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        if (cat.updating) {
            return res
                .status(409)
                .json({
                    error:
                        'Кот уже обновляется'
                });
        }

        cat.updating = true;

        cat.updateError = null;

        saveDatabase();

        try {
            const result =
                await updateCat(
                    cat
                );

            cat.updating =
                false;

            saveDatabase();

            res.json({
                ok: true,

                result,

                cat:
                    buildCatResponse(
                        cat
                    )
            });
        } catch (error) {
            cat.updating =
                false;

            cat.updateError =
                error.message;

            saveDatabase();

            res
                .status(500)
                .json({
                    error:
                        error.message
                });
        }
    }
);

/*
|--------------------------------------------------------------------------
| UPDATE ALL
|--------------------------------------------------------------------------
*/

let updateAllRunning =
    false;

app.post(
    '/api/cats/update-all',
    async (req, res) => {
        if (updateAllRunning) {
            return res
                .status(409)
                .json({
                    error:
                        'Обновление уже выполняется'
                });
        }

        updateAllRunning = true;

        const results = [];

        try {
            for (
                let index = 0;
                index <
                database.cats.length;
                index++
            ) {
                const cat =
                    database.cats[index];

                cat.updating =
                    true;

                cat.updateError =
                    null;

                saveDatabase();

                try {
                    const result =
                        await updateCat(
                            cat
                        );

                    results.push({
                        catId:
                            cat.id,

                        ok: true,

                        result
                    });
                } catch (error) {
                    cat.updateError =
                        error.message;

                    results.push({
                        catId:
                            cat.id,

                        ok: false,

                        error:
                            error.message
                    });
                }

                cat.updating =
                    false;

                saveDatabase();

                /*
                 * Интервал между котами.
                 */

                if (
                    index <
                    database.cats.length -
                    1
                ) {
                    await sleep(
                        Math.max(
                            1000,
                            toInt(
                                database
                                    .settings
                                    .updateIntervalMs,
                                7000
                            )
                        )
                    );
                }
            }

            res.json({
                ok: true,

                results
            });
        } finally {
            updateAllRunning =
                false;
        }
    }
);

/*
|--------------------------------------------------------------------------
| RESET
|--------------------------------------------------------------------------
*/

app.post(
    '/api/cats/:id/reset',
    (req, res) => {
        const cat =
            database.cats.find(
                item =>
                    item.id ===
                    req.params.id
            );

        if (!cat) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        database.history.push({
            id: createId(),

            type: 'reset',

            catId:
                cat.id,

            createdAt:
                now(),

            snapshot:
                makeSnapshot(
                    cat
                )
        });

        saveDatabase();

        res.json({
            ok: true
        });
    }
);

app.post(
    '/api/reset-all',
    (req, res) => {
        database.history.push({
            id: createId(),

            type: 'reset-all',

            createdAt:
                now(),

            cats:
                database.cats.map(
                    cat => ({
                        catId:
                            cat.id,

                        snapshot:
                            makeSnapshot(
                                cat
                            )
                    })
                )
        });

        saveDatabase();

        res.json({
            ok: true
        });
    }
);

/*
|--------------------------------------------------------------------------
| STATISTICS
|--------------------------------------------------------------------------
*/

function calculateCatStats(
    cat
) {
    const result = {
        sold: 0,

        bought: 0,

        revenue: 0,

        purchaseCost: 0,

        restockCost: 0,

        profit: 0
    };

    for (
        const item
        of cat.items
    ) {
        const product =
            database.products.find(
                p =>
                    p.id ===
                    item.productId
            );

        if (!product) {
            continue;
        }

        const calculated =
            calculateItem(
                item,
                product
            );

        result.sold +=
            calculated.sold;

        result.bought +=
            calculated.bought;

        result.revenue +=
            calculated.revenue;

        result.purchaseCost +=
            calculated.purchaseCost;

        result.restockCost +=
            calculated.restockCost;

        result.profit +=
            calculated.profit;
    }

    return result;
}

app.get(
    '/api/stats/cat/:id',
    (req, res) => {
        const cat =
            database.cats.find(
                item =>
                    item.id ===
                    req.params.id
            );

        if (!cat) {
            return res
                .status(404)
                .json({
                    error:
                        'Кот не найден'
                });
        }

        res.json(
            calculateCatStats(
                cat
            )
        );
    }
);

app.get(
    '/api/stats/all',
    (req, res) => {
        const total = {
            sold: 0,

            bought: 0,

            revenue: 0,

            purchaseCost: 0,

            restockCost: 0,

            profit: 0
        };

        const cats =
            database.cats.map(
                cat => {
                    const stats =
                        calculateCatStats(
                            cat
                        );

                    return {
                        catId:
                            cat.id,

                        name:
                            cat.name,

                        ...stats
                    };
                }
            );

        for (
            const stats
            of cats
        ) {
            total.sold +=
                stats.sold;

            total.bought +=
                stats.bought;

            total.revenue +=
                stats.revenue;

            total.purchaseCost +=
                stats.purchaseCost;

            total.restockCost +=
                stats.restockCost;

            total.profit +=
                stats.profit;
        }

        res.json({
            total,
            cats
        });
    }
);

app.get(
    '/api/history/:catId',
    (req, res) => {
        const limit =
            Math.min(
                1000,
                Math.max(
                    1,
                    toInt(
                        req.query.limit,
                        100
                    )
                )
            );

        res.json(
            database.history
                .filter(
                    entry =>
                        entry.catId ===
                        req.params.catId
                )
                .slice(-limit)
                .reverse()
        );
    }
);

/*
|--------------------------------------------------------------------------
| RESPONSE
|--------------------------------------------------------------------------
*/

function buildCatResponse(
    cat
) {
    return {
        ...cat,

        items:
            cat.items
                .map(
                    item => {
                        const product =
                            database
                                .products
                                .find(
                                    p =>
                                        p.id ===
                                        item.productId
                                );

                        if (!product) {
                            return null;
                        }

                        const calculated =
                            calculateItem(
                                item,
                                product
                            );

                        return {
                            ...item,

                            productId:
                                product.id,

                            externalId:
                                product.externalId,

                            name:
                                product.name,

                            image:
                                product.image,

                            configured:
                                product.configured,

                            ...calculated
                        };
                    }
                )
                .filter(Boolean)
    };
}

